{
  "schema_version": "tool_profile.v1",
  "tool": "tflint",
  "profile_id": "tflint-json-v1",
  "profile_version": "1.0.0",
  "certified_versions": ["0"],
  "compatible_versions": ["0"],
  "version_policy": "certified_only",
  "version_discovery": {
    "command": "tflint",
    "args": ["--version"]
  },
  "scan_command": {
    "command": "tflint",
    "args": ["--format", "json"]
  },
  "parser": {
    "type": "json",
    "result": "tflint"
  },
  "mapping": {
    "issues": {"path": "issues"}
  },
  "redaction": {
    "max_output_bytes": 1048576
  }
}
